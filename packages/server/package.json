{
  "name": "@milfordai/server",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "milford-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@milfordai/channels": "workspace:*",
    "@milfordai/config": "workspace:*",
    "@milfordai/core": "workspace:*",
    "@milfordai/mcp": "workspace:*",
    "@milfordai/providers": "workspace:*",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "description": "Milford HTTP server: run flows over REST with server-sent events, idempotency keys and bearer auth.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milfordai/milford.git",
    "directory": "packages/server"
  },
  "homepage": "https://milford.mintlify.site",
  "bugs": {
    "url": "https://github.com/milfordai/milford/issues"
  },
  "keywords": [
    "milford",
    "workflow",
    "http",
    "sse",
    "openapi"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
