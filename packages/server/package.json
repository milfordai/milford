{
  "name": "@loage/server",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "loage-server": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
