{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "fallback": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "circuitBreaker": {
            "type": "object",
            "properties": {
              "failures": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "resetMs": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "failures",
              "resetMs"
            ],
            "additionalProperties": false
          },
          "rateLimit": {
            "type": "object",
            "properties": {
              "perSecond": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "burst": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "perSecond"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": {}
      }
    },
    "flows": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "additionalProperties": false
      }
    },
    "channels": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "flow": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "flow"
        ],
        "additionalProperties": {}
      }
    },
    "server": {
      "default": {
        "port": 8080,
        "auth": {
          "tokens": []
        },
        "runTimeoutMs": 60000,
        "maxConcurrentRuns": 64,
        "idempotencyTtlMs": 600000,
        "maxBodyBytes": 1000000
      },
      "type": "object",
      "properties": {
        "port": {
          "default": 8080,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "auth": {
          "default": {
            "tokens": []
          },
          "type": "object",
          "properties": {
            "tokens": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "tokens"
          ],
          "additionalProperties": false
        },
        "runTimeoutMs": {
          "default": 60000,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxConcurrentRuns": {
          "default": 64,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "idempotencyTtlMs": {
          "default": 600000,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxBodyBytes": {
          "default": 1000000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "port",
        "auth",
        "runTimeoutMs",
        "maxConcurrentRuns",
        "idempotencyTtlMs",
        "maxBodyBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "providers",
    "flows",
    "channels",
    "server"
  ],
  "additionalProperties": false
}
