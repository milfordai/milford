        "value": "none_of_these"
      }
    },
    {
      "from": "device",
      "to": "call-fans",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "call-fans",
      "to": "out"
    },
    {
      "from": "in",
      "to": "act-locks"
    },
    {
      "from": "class",
      "to": "call-locks",
      "when": {
        "path": "data.choice",
        "op": "eq",
        "value": "locks"
      }
    },
    {
      "from": "act-locks",
      "to": "call-locks",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "room",
      "to": "call-locks",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "device",
      "to": "call-locks",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "call-locks",
      "to": "out"
    },
    {
      "from": "in",
      "to": "act-appliances"
    },
    {
      "from": "class",
      "to": "call-appliances",
      "when": {
        "path": "data.choice",
        "op": "eq",
        "value": "appliances"
      }
    },
    {
      "from": "act-appliances",
      "to": "call-appliances",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "room",
      "to": "call-appliances",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "device",
