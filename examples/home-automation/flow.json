{
  "id": "home",
  "nodes": [
    {
      "id": "in",
      "type": "input"
    },
    {
      "id": "room",
      "type": "decision",
      "config": {
        "provider": "jev",
        "kind": "choice",
        "prompt": "Which room does the user mean?",
        "options": "{{input.rooms}}",
        "state": "{{input.command}}",
        "minConfidence": 0.5
      }
    },
    {
      "id": "device",
      "type": "decision",
      "config": {
        "provider": "jev",
        "kind": "choice",
        "prompt": "Which device does the user mean?",
        "options": "{{input.devices}}",
        "state": "{{input.command}}",
        "minConfidence": 0.5
      }
    },
    {
      "id": "class",
      "type": "decision",
      "config": {
        "provider": "jev",
        "kind": "choice",
        "prompt": "Which kind of device does the user want to control?",
        "options": [
          "lights",
          "fans",
          "locks",
          "appliances",
          "speakers",
          "thermostats"
        ],
        "state": "{{input.command}}",
        "minConfidence": 0.6
      }
    },
    {
      "id": "noop",
      "type": "prompt",
      "config": {
        "template": "That is not something I can do at home."
      }
    },
    {
      "id": "clarify",
      "type": "prompt",
      "config": {
        "template": "Which room and device do you mean?"
      }
    },
    {
      "id": "out",
      "type": "output"
    },
    {
      "id": "act-lights",
      "type": "decision",
      "config": {
        "provider": "jev",
        "kind": "choice",
        "prompt": "What should happen to the lights?",
        "options": [
          "on",
          "off"
        ],
        "state": "{{input.command}}",
        "minConfidence": 0.5
      }
    },
    {
      "id": "call-lights",
      "type": "http",
      "config": {
        "url": "{{input.homeUrl}}/devices/{{device}}",
        "method": "POST",
        "body": {
          "device": "{{device}}",
          "room": "{{room}}",
          "action": "{{act-lights}}"
        }
      },
      "join": "all"
    },
    {
      "id": "act-fans",
      "type": "decision",
      "config": {
        "provider": "jev",
        "kind": "choice",
        "prompt": "What should happen to the fans?",
        "options": [
          "on",
          "off"
        ],
        "state": "{{input.command}}",
        "minConfidence": 0.5
      }
    },
    {
      "id": "call-fans",
      "type": "http",
      "config": {
        "url": "{{input.homeUrl}}/devices/{{device}}",
        "method": "POST",
        "body": {
          "device": "{{device}}",
          "room": "{{room}}",
          "action": "{{act-fans}}"
        }
      },
      "join": "all"
    },
    {
      "id": "act-locks",
      "type": "decision",
      "config": {
        "provider": "jev",
        "kind": "choice",
        "prompt": "What should happen to the locks?",
        "options": [
          "locked",
          "unlocked"
        ],
        "state": "{{input.command}}",
        "minConfidence": 0.5
      }
    },
    {
      "id": "call-locks",
      "type": "http",
      "config": {
        "url": "{{input.homeUrl}}/devices/{{device}}",
        "method": "POST",
        "body": {
          "device": "{{device}}",
          "room": "{{room}}",
          "action": "{{act-locks}}"
        }
      },
      "join": "all"
    },
    {
      "id": "act-appliances",
      "type": "decision",
      "config": {
        "provider": "jev",
        "kind": "choice",
        "prompt": "What should happen to the appliances?",
        "options": [
          "on",
          "off"
        ],
        "state": "{{input.command}}",
        "minConfidence": 0.5
      }
    },
    {
      "id": "call-appliances",
      "type": "http",
      "config": {
        "url": "{{input.homeUrl}}/devices/{{device}}",
        "method": "POST",
        "body": {
          "device": "{{device}}",
          "room": "{{room}}",
          "action": "{{act-appliances}}"
        }
      },
      "join": "all"
    },
    {
      "id": "act-speakers",
      "type": "decision",
      "config": {
        "provider": "jev",
        "kind": "choice",
        "prompt": "What should happen to the speakers?",
        "options": [
          "on",
          "off"
        ],
        "state": "{{input.command}}",
        "minConfidence": 0.5
      }
    },
    {
      "id": "call-speakers",
      "type": "http",
      "config": {
        "url": "{{input.homeUrl}}/devices/{{device}}",
        "method": "POST",
        "body": {
          "device": "{{device}}",
          "room": "{{room}}",
          "action": "{{act-speakers}}"
        }
      },
      "join": "all"
    },
    {
      "id": "act-thermostats",
      "type": "decision",
      "config": {
        "provider": "jev",
        "kind": "choice",
        "prompt": "What should happen to the thermostats?",
        "options": [
          "warmer",
          "cooler"
        ],
        "state": "{{input.command}}",
        "minConfidence": 0.5
      }
    },
    {
      "id": "call-thermostats",
      "type": "http",
      "config": {
        "url": "{{input.homeUrl}}/devices/{{device}}",
        "method": "POST",
        "body": {
          "device": "{{device}}",
          "room": "{{room}}",
          "action": "{{act-thermostats}}"
        }
      },
      "join": "all"
    }
  ],
  "edges": [
    {
      "from": "in",
      "to": "room"
    },
    {
      "from": "in",
      "to": "device"
    },
    {
      "from": "in",
      "to": "class"
    },
    {
      "from": "class",
      "to": "noop",
      "when": {
        "path": "data.choice",
        "op": "eq",
        "value": "none_of_these"
      }
    },
    {
      "from": "room",
      "to": "clarify",
      "when": {
        "path": "data.choice",
        "op": "eq",
        "value": "none_of_these"
      }
    },
    {
      "from": "device",
      "to": "clarify",
      "when": {
        "path": "data.choice",
        "op": "eq",
        "value": "none_of_these"
      }
    },
    {
      "from": "noop",
      "to": "out"
    },
    {
      "from": "clarify",
      "to": "out"
    },
    {
      "from": "in",
      "to": "act-lights"
    },
    {
      "from": "class",
      "to": "call-lights",
      "when": {
        "path": "data.choice",
        "op": "eq",
        "value": "lights"
      }
    },
    {
      "from": "act-lights",
      "to": "call-lights",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "room",
      "to": "call-lights",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "device",
      "to": "call-lights",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "call-lights",
      "to": "out"
    },
    {
      "from": "in",
      "to": "act-fans"
    },
    {
      "from": "class",
      "to": "call-fans",
      "when": {
        "path": "data.choice",
        "op": "eq",
        "value": "fans"
      }
    },
    {
      "from": "act-fans",
      "to": "call-fans",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
