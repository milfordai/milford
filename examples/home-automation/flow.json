      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "call-appliances",
      "to": "out"
    },
    {
      "from": "in",
      "to": "act-speakers"
    },
    {
      "from": "class",
      "to": "call-speakers",
      "when": {
        "path": "data.choice",
        "op": "eq",
        "value": "speakers"
      }
    },
    {
      "from": "act-speakers",
      "to": "call-speakers",
      "when": {
        "path": "data.choice",
        "op": "neq",
        "value": "none_of_these"
      }
    },
    {
      "from": "room",
